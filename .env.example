# Copy to ~/.config/schwab-mcp/.env (or ./.env) and fill in. Never commit the real file.

# App Key / Secret from https://developer.schwab.com -> Dashboard -> your app
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=

# Must match the callback URL registered for the app EXACTLY (no trailing slash).
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Where the OAuth token is stored (default: ~/.config/schwab-mcp/token.json).
# SCHWAB_TOKEN_PATH=

# Show full account numbers to the model instead of ****1234.
# SCHWAB_MCP_MASK_ACCOUNTS=true

# Required only for `schwab-mcp serve --transport http`: clients send it as "Authorization: Bearer <token>".
# SCHWAB_MCP_HTTP_TOKEN=
